# ---------------------------------------------------------------------------
# Leaf Coaching — PayPal checkout
# Copy this file to `.env.local` and fill in your own values.
# ---------------------------------------------------------------------------

# Optional. The checkout also fetches the public client ID at runtime from
# /api/paypal/config, so PAYPAL_CLIENT_ID below is the source of truth. Set this
# to avoid the extra request. Safe to expose; it cannot take payments without
# the secret.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Server-side REST app credentials (used to create and capture orders).
# PAYPAL_CLIENT_ID is also served to the browser by /api/paypal/config.
# Leave both blank to keep checkout in "email us" fallback mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# "sandbox" (default) or "live". Never commit live credentials.
PAYPAL_ENV=sandbox

# Optional. If set, captured orders are POSTed here as JSON for your own
# bookkeeping (e.g. a Zapier/Make webhook or an internal endpoint).
PAYMENT_NOTIFICATION_WEBHOOK=

# Optional. Signs private download links for digital products.
# Falls back to PAYPAL_CLIENT_SECRET, but set it explicitly in production so
# existing links keep working if the PayPal credentials are ever rotated.
DOWNLOAD_SIGNING_SECRET=

# Optional. Public origin used when building download links, e.g.
# https://www.leafcoaching.com. Defaults to the incoming request's host.
SITE_URL=

# ---------------------------------------------------------------------------
# Tea Stories staff admin
# ---------------------------------------------------------------------------

# Password for the staff area at /admin. Keep this long and unique.
ADMIN_PASSWORD=

# Signs the 8-hour staff session cookie. Generate a random value, for example:
#   openssl rand -base64 32
# Falls back to ADMIN_PASSWORD if omitted, but set it explicitly in production.
ADMIN_SESSION_SECRET=

# Vercel Blob token for storing stories and images in production.
# Create a Blob store in the Vercel dashboard and connect it to the project.
# When omitted locally, stories are written to .data/ and images to
# public/uploads/tea-stories (development only). On Vercel, omission disables
# saving until a Blob store is connected.
BLOB_READ_WRITE_TOKEN=
